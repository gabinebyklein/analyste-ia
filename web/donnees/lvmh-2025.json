dans_le_cours_pct": 0.1924566889399119}, "wacc": {"wacc_pct": 6.943709775167242, "beta_retenu": 0.9, "cout_fonds_propres_pct": 7.18, "cout_dette_apres_impot_pct": 2.8937999999999997, "poids_dette_pct": 5.512813793867707}, "comparables": {"ve_ebitda_q1_med_q3": [13.224, 15.772, 17.6585], "per_q1_med_q3": [15.2297495, 24.927329999999998, 31.1427715], "prix_ve_ebitda": [635.0064886143753, 768.765665032253, 867.7989014185662], "prix_per": [332.77002657500003, 544.6621605, 680.469557275], "retenus_ve_ebitda": 5, "retenus_per": 4}, "fourchettes": {"DCF (WACC ± 1 pt, g ± 0,5 pt)": [433.78145685437346, 878.6159767323518], "VE/EBITDA des pairs": [635.0064886143753, 867.7989014185662], "PER des pairs": [332.77002657500003, 680.469557275], "Cours sur 52 semaines": [375.65, 654.3]}, "analyse": {"en_une_phrase": "LVMH a vu ses ventes passer de 86,2 Md€ en 2023 à 80,8 Md€ en 2025, avec une marge opérationnelle ramenée de 26,5 % à 22,0 %, tandis que le flux de trésorerie d'exploitation est monté à 11,3 Md€.", "points_forts": ["Le flux de trésorerie d'exploitation progresse chaque année : 8,1 Md€ en 2023, 10,5 Md€ en 2024, puis 11,3 Md€ en 2025.", "La dette financière nette recule de 14,1 Md€ en 2023 à 11,5 Md€ en 2025, pour un levier stable autour de 1,1x l'EBITDA.", "La marge brute reste élevée à 66,2 % en 2025, et la marge opérationnelle se maintient à 22,0 %."], "points_de_vigilance": ["Les ventes reculent pour la deuxième année de suite : -1,7 % en 2024, puis -4,6 % en 2025.", "Les marges baissent à tous les niveaux : la marge opérationnelle passe de 26,5 % à 22,0 % et la marge nette de 17,6 % à 13,5 % entre 2023 et 2025.", "La rentabilité des capitaux propres tombe de 24,9 % en 2023 à 16,1 % en 2025, et l'EBITDA de 30,0 Md€ à 25,8 Md€."], "lecture_de_la_valorisation": "Le DCF, construit avec un WACC de 6,9 % et une croissance perpétuelle de 2,5 %, donne 581,3 € par action ; la valeur terminale en représente 82,1 %, et la fourchette de sensibilité va de 434 € à 879 €. Les comparables donnent 768,8 € en médiane sur le VE/EBITDA (15,8x, 5 sociétés retenues) et 544,7 € sur le PER (24,9x, 4 sociétés retenues). À 403 €, le cours suppose une croissance perpétuelle de 0,2 %, contre 2,5 % dans le scénario central du DCF.", "pour_un_gestionnaire_de_patrimoine": "Le titre offre un rendement du dividende de 3,2 %, pour 7,1 Md€ de dividendes versés en 2025, et l'endettement reste mesuré avec un levier de 1,1x l'EBITDA. Le beta de 0,9 indique une volatilité proche de celle du marché, mais le cours a varié entre 376 € et 654 € sur 52 semaines."}, "recoupement": {"nb_compares": 22, "nb_concordants": 22, "comparaisons": [{"poste": "ventes", "annee": "2023", "lu_dans_le_rapport": 86153.0, "page": 338, "depot_officiel": 86153.0, "concorde": true}, {"poste": "ventes", "annee": "2024", "lu_dans_le_rapport": 84683.0, "page": 338, "depot_officiel": 84683.0, "concorde": true}, {"poste": "marge_brute", "annee": "2023", "lu_dans_le_rapport": 59277.0, "page": 338, "depot_officiel": 59277.0, "concorde": true}, {"poste": "marge_brute", "annee": "2024", "lu_dans_le_rapport": 56765.0, "page": 338, "depot_officiel": 56765.0, "concorde": true}, {"poste": "resultat_net_part_du_groupe", "annee": "2023", "lu_dans_le_rapport": 15174.0, "page": 338, "depot_officiel": 15174.0, "concorde": true}, {"poste": "resultat_net_part_du_groupe", "annee": "2024", "lu_dans_le_rapport": 12550.0, "page": 338, "depot_officiel": 12550.0, "concorde": true}, {"poste": "bpa_dilue", "annee": "2023", "lu_dans_le_rapport": 30.33, "page": 338, "depot_officiel": 30.33, "concorde": true}, {"poste": "bpa_dilue", "annee": "2024", "lu_dans_le_rapport": 25.12, "page": 338, "depot_officiel": 25.12, "concorde": true}, {"poste": "capitaux_propres", "annee": "2023", "lu_dans_le_rapport": 62701.0, "page": 340, "depot_officiel": 62701.0, "concorde": true}, {"poste": "capitaux_propres", "annee": "2024", "lu_dans_le_rapport": 69287.0, "page": 340, "depot_officiel": 69287.0, "concorde": true}, {"poste": "interet